{
  "branches": [
    "main",
    {
      "name": "releases/+([0-9]).+([0-9]).x",
      "range": "${name.replace('releases/', '')}"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/idl/mainnet/*.json" },
          { "path": "dist/idl/devnet/*.json" },
          { "path": "dist/program/mainnet/*.so" },
          { "path": "dist/program/devnet/*.so" },
          { "path": "dist/program-keypairs.mjs" }
        ]
      }
    ]
  ]
}
